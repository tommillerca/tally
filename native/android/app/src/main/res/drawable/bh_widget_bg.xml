<?xml version="1.0" encoding="utf-8"?>
<!-- The pit backdrop, matching containerBackground in BoneheadzWidget.swift, so
     the widget reads as part of the game on both platforms rather than as a
     system card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#0D0D12"
        android:endColor="#121C14" />
</shape>
